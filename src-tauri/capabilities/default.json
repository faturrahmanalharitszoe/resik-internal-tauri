{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Izin default untuk window utama Resik Internal",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://internal.resikcemerlang.com",
      "http://localhost:3002"
    ]
  },
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:default"
  ]
}